# Local Convex backend (Docker self-host)
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=convex-self-hosted|replace-with-generated-key

# Read by the Expo app
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Clerk publishable key (public by design). Development instance: pk_test_…
# The backend also needs its issuer, set once per Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<instance>.clerk.accounts.dev
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional diagnostics labels; never put a secret behind EXPO_PUBLIC_.
EXPO_PUBLIC_BUILD_ID=
EXPO_PUBLIC_ENVIRONMENT=
